{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life OS",
  "version": "0.1.1",
  "identifier": "xyz.dktunnel.lifeos",
  "mainBinaryName": "lifeos",

  "build": {
    "frontendDist": "https://lifeos.dktunnel.xyz"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Life OS",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["remote-panel"]
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Life OS",
      "menuOnLeftClick": false
    }
  },

  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Life OS — панель управления агентами",
    "longDescription": "Нативный клиент Life OS для Linux: трей, уведомления, горячие клавиши и автозапуск. Интерфейс и агенты живут на сервере.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
